<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_guesthouse_form" model="ir.ui.view">
        <field name="name">res.partner.form.guesthouse</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]/group[1]" position="inside">
                <field name="is_guest" string="Guest" groups="thimo_guesthouse.group_guesthouse_receptionist"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page name="guesthouse_bookings" string="Guest House Bookings" invisible="not is_guest" groups="thimo_guesthouse.group_guesthouse_receptionist">
                    <field name="guesthouse_booking_ids" readonly="True">
                        <list create="False" edit="False" delete="False">
                            <field name="name"/>
                            <field name="room_id"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="total" widget="monetary"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_guest_list" model="ir.ui.view">
        <field name="name">res.partner.guesthouse.list</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Guests">
                <field name="name"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="city" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_guest_search" model="ir.ui.view">
        <field name="name">res.partner.guesthouse.search</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Guests">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_guests" model="ir.actions.act_window">
        <field name="name">Guests</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_guest_search"/>
        <field name="domain">[('is_guest', '=', True)]</field>
        <field name="context">{'default_is_guest': True}</field>
        <field name="path">guesthouse-guests</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create a guest using Odoo Contacts.</p></field>
    </record>
    <record id="action_guests_list_view" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_guest_list"/>
        <field name="act_window_id" ref="action_guests"/>
    </record>
    <record id="action_guests_form_view" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_guests"/>
    </record>
</odoo>
