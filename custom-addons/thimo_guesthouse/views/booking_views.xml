<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_list" model="ir.ui.view">
        <field name="name">thimo.guesthouse.booking.list</field>
        <field name="model">thimo.guesthouse.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="nightly_rate" widget="monetary" optional="hide"/>
                <field name="number_of_nights"/>
                <field name="total" widget="monetary"/>
                <field name="state" widget="badge" decoration-info="state == 'confirmed'" decoration-warning="state == 'checked_in'" decoration-success="state == 'checked_out'"/>
            </list>
        </field>
    </record>
    <record id="view_booking_form" model="ir.ui.view">
        <field name="name">thimo.guesthouse.booking.form</field>
        <field name="model">thimo.guesthouse.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'" groups="thimo_guesthouse.group_guesthouse_receptionist"/>
                    <button name="action_check_in" type="object" string="Check In" class="oe_highlight" invisible="state != 'confirmed'" groups="thimo_guesthouse.group_guesthouse_receptionist"/>
                    <button name="action_check_out" type="object" string="Check Out" class="oe_highlight" invisible="state != 'checked_in'" groups="thimo_guesthouse.group_guesthouse_receptionist"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'confirmed'" groups="thimo_guesthouse.group_guesthouse_receptionist"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,checked_out,cancelled" readonly="True"/>
                </header>
                <sheet>
                    <group>
                        <group string="Reservation">
                            <field name="name" readonly="True" placeholder="Assigned on save"/>
                            <field name="guest_id" readonly="state != 'draft'" context="{'default_is_guest': True}"/>
                            <field name="room_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="check_in" string="Check-in Date" readonly="state != 'draft'"/>
                            <field name="check_out" string="Check-out Date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Accommodation">
                            <field name="currency_id" invisible="True"/>
                            <field name="nightly_rate" readonly="state != 'draft'" widget="monetary"/>
                            <field name="number_of_nights" readonly="True"/>
                            <field name="total" readonly="True" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_booking_search" model="ir.ui.view">
        <field name="name">thimo.guesthouse.booking.search</field>
        <field name="model">thimo.guesthouse.booking</field>
        <field name="arch" type="xml">
            <search string="Bookings">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="checked_in" string="Checked In" domain="[('state', '=', 'checked_in')]"/>
                <filter name="checked_out" string="Checked Out" domain="[('state', '=', 'checked_out')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_room" string="Room" context="{'group_by': 'room_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_bookings" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">thimo.guesthouse.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_booking_search"/>
        <field name="path">guesthouse-bookings</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create a booking, then confirm it before check-in.</p></field>
    </record>
</odoo>
