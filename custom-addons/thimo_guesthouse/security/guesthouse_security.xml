<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_guesthouse" model="ir.module.category">
        <field name="name">Guest House</field>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_guesthouse" model="res.groups.privilege">
        <field name="name">Guest House</field>
        <field name="category_id" ref="module_category_guesthouse"/>
    </record>
    <record id="group_guesthouse_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_guesthouse"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>
    <record id="group_guesthouse_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_guesthouse"/>
        <field name="implied_ids" eval="[(4, ref('group_guesthouse_receptionist'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
